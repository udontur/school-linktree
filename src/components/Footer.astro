---
let buildNumber = "NOT_PRODUCTION"
let envBuildNumber=import.meta.env.CF_PAGES_COMMIT_SHA
if(envBuildNumber!=undefined){
    buildNumber=envBuildNumber.slice(0, 8)
}
---
<div class="flex justify-center">
    <div class="mt-12 mb-12 text-xs text-invis cursor-default hover:text-hover">
        Build
        <a
            class="underline decoration-solid"
            href={"https://github.com/udontur/school-linktree/tree/"+envBuildNumber}
        >
            {buildNumber}</a
        >
        made with passion by
        <a href="https://hadrian.cc">Hadrian</a>
    </div>
</div>
